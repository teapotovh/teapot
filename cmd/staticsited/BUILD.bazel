load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "image_layer")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:push.bzl", "image_push")

go_library(
    name = "staticsited_lib",
    srcs = ["staticsited.go"],
    importpath = "github.com/teapotovh/teapot/cmd/staticsited",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/httplog",
        "//lib/httpsrv",
        "//lib/log",
        "//lib/observability",
        "//lib/run",
        "//service/staticsite",
        "@com_github_spf13_pflag//:pflag",
    ],
)

go_binary(
    name = "staticsited",
    embed = [":staticsited_lib"],
    visibility = ["//visibility:public"],
)

go_binary(
    name = "staticsited_static",
    embed = [":staticsited_lib"],
    pure = "on",
    static = "on",
    visibility = ["//visibility:public"],
)

# OCI Image building
image_layer(
    name = "binary_layer",
    srcs = {
        "/staticsited": ":staticsited_static",
    },
    compress = "zstd",
)

image_manifest(
    name = "image",
    base = "@distroless_static_debian13",
    entrypoint = ["/staticsited"],
    layers = [
        ":binary_layer",
    ],
    platform = "@zig_sdk//libc_aware/platform:linux_amd64_gnu.2.28",
)

image_load(
    name = "load",
    image = ":image",
    tag = "ghcr.io/teapotovh/staticsited:latest",
)

image_push(
    name = "push",
    image = ":image",
    registry = "ghcr.io",
    repository = "teapotovh/staticsited",
    stamp = "disabled",
    tag_file = "//bazel:version_file_latest",
)

image_push(
    name = "push_ttl",
    image = ":image",
    registry = "ocihub.com",
    repository = "teapotovh_staticsited",
    tag = "1h",
)
