load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "httpsrv",
    srcs = [
        "flag.go",
        "httpsrv.go",
        "metrics.go",
        "z.go",
    ],
    importpath = "github.com/teapotovh/teapot/lib/httpsrv",
    visibility = ["//visibility:public"],
    deps = [
        "//lib/httptrace",
        "//lib/observability",
        "//lib/run",
        "//lib/wideevent",
        "@com_github_kataras_requestid//:requestid",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_spf13_pflag//:pflag",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_test(
    name = "httpsrv_test",
    srcs = ["httpsrv_test.go"],
    embed = [":httpsrv"],
    size = "small",  # gazelle:keep
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
