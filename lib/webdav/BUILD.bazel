load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "webdav",
    srcs = [
        "etag.go",
        "method.go",
        "server.go",
        "webdav.go",
    ],
    importpath = "github.com/teapotovh/teapot/lib/webdav",
    visibility = ["//visibility:public"],
    deps = [
        "//lib/webdav/error",
        "//lib/webdav/internal",
    ],
)

go_test(
    name = "webdav_test",
    srcs = [
        "etag_test.go",
        "webdav_test.go",
    ],
    embed = [":webdav"],
    deps = [
        "//lib/webdav/error",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
