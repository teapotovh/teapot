load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "mail",
    srcs = [
        "flag.go",
        "mail.go",
        "metrics.go",
        "notifications.go",
        "recipient.go",
    ],
    importpath = "github.com/teapotovh/teapot/service/mail",
    visibility = ["//visibility:public"],
    deps = [
        "//lib/ldap",
        "//lib/observability",
        "//lib/pgnotify",
        "//lib/run",
        "//service/mail/store",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_spf13_pflag//:pflag",
    ],
)

go_test(
    name = "mail_test",
    srcs = [
        "e2e_test.go",
        "notifications_test.go",
    ],
    embed = [":mail"],
    deps = [
        "//lib/ldap",
        "//service/mail/imap",
        "//service/mail/lmtp",
        "//service/mail/mailtest",
        "//service/mail/store",
        "@com_github_emersion_go_imap_v2//:go-imap",
        "@com_github_emersion_go_imap_v2//imapclient",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//require",
    ],
)
