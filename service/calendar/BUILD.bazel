load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "calendar",
    srcs = [
        "calendar.go",
        "flags.go",
        "metrics.go",
        "z.go",
    ],
    importpath = "github.com/teapotovh/teapot/service/calendar",
    visibility = ["//visibility:public"],
    deps = [
        "//lib/httpauth",
        "//lib/httplog",
        "//lib/ldap",
        "//lib/observability",
        "//lib/webdav/caldav",
        "//lib/wellknown",
        "//service/calendar/backend",
        "//service/calendar/store",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_spf13_pflag//:pflag",
    ],
)

go_test(
    name = "calendar_test",
    srcs = ["calendar_test.go"],
    data = glob(["testdata/**"]),
    embed = [":calendar"],
    embedsrcs = [
        "testdata/calendar-query.xml",
        "testdata/event.ics",
        "testdata/mkcalendar.xml",
    ],
    deps = [
        "//lib/httpauth",
        "//lib/httplog",
        "//lib/ldap",
        "//lib/wellknown",
        "//service/calendar/backend",
        "//service/calendar/store",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
