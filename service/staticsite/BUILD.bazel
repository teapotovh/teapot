load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "staticsite",
    srcs = [
        "flag.go",
        "handler.go",
        "staticsite.go",
        "usercache.go",
        "z.go",
    ],
    importpath = "github.com/teapotovh/teapot/service/staticsite",
    visibility = ["//visibility:public"],
    deps = [
        "//lib/fs",
        "//lib/httplog",
        "//lib/ldap",
        "//lib/observability",
        "//lib/remotefiles",
        "//lib/run",
        "//lib/s3cache",
        "//proto/files:files_go_proto",
        "@com_github_spf13_pflag//:pflag",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)

go_test(
    name = "staticsite_test",
    srcs = [
        "handler_test.go",
        "staticsite_test.go",
        "usercache_test.go",
    ],
    embed = [":staticsite"],
    deps = [
        "//lib/httplog",
        "//lib/ldap",
        "//lib/remotefiles",
        "//lib/run",
        "//lib/s3cache",
