load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "releasebranch_lib",
    srcs = ["branch.go"],
    embedsrcs = ["gitrepository.yaml"],
    importpath = "github.com/teapotovh/teapot/tools/releasebranch",
    visibility = ["//visibility:private"],
    deps = [
        "//tools/util",
        "@io_k8s_sigs_kustomize_api//types",
        "@io_k8s_sigs_yaml//:yaml",
    ],
)

go_binary(
    name = "releasebranch",
    data = ["//bazel:repository_file"],
    embed = [":releasebranch_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "releasebranch_test",
    srcs = ["branch_test.go"],
    embed = [":releasebranch_lib"],
    deps = [
        "@io_k8s_sigs_kustomize_api//types",
        "@io_k8s_sigs_yaml//:yaml",
    ],
)
