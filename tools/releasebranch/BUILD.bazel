load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "releasebranch_lib",
    srcs = ["branch.go"],
    embedsrcs = [
        "base.kustomization.yaml",
        "gitrepository.yaml",
        "images.patch.yaml",
        "release.kustomization.yaml",
    ],
    importpath = "github.com/teapotovh/teapot/tools/releasebranch",
    visibility = ["//visibility:private"],
    deps = ["//tools/util"],
)

go_binary(
    name = "releasebranch",
    data = ["//bazel:repository_file"],
    embed = [":releasebranch_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "releasebranch_test",
    srcs = [
        "branch_test.go",
        "templates_test.go",
    ],
    embed = [":releasebranch_lib"],
)
