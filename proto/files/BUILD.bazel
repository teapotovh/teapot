# gazelle:exclude files.pb.go
# gazelle:exclude files_vtproto.pb.go
# gazelle:exclude generated/**
# gazelle:go_generate_proto false

load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "files_proto",
    srcs = ["files.proto"],
    visibility = ["//visibility:private"],
    deps = ["@protobuf//:timestamp_proto"],
)

go_proto_library(
    name = "files_go_proto",
    compilers = [
        "@rules_go//proto:go_grpc",
        "//proto:go_vtproto",
    ],
    importpath = "github.com/teapotovh/teapot/proto/files",
    protos = [":files_proto"],
    visibility = ["//visibility:public"],
    deps = ["@com_github_planetscale_vtprotobuf//types/known/timestamppb"],
)

filegroup(
    name = "files_pb_go",
    srcs = [":files_go_proto"],
    output_group = "go_generated_srcs",
)

# isolate individual files by filtering on filename
genrule(
    name = "files_pb_go_only",
    srcs = [":files_pb_go"],
    outs = ["generated/files.pb.go"],
    cmd = "for f in $(SRCS); do case $$f in *_vtproto.pb.go) ;; *.pb.go) cp $$f $@ ;; esac; done",
)

genrule(
    name = "files_vt_pb_go_only",
    srcs = [":files_pb_go"],
    outs = ["generated/files_vtproto.pb.go"],
    cmd = "for f in $(SRCS); do case $$f in *_vtproto.pb.go) cp $$f $@ ;; esac; done",
)

write_source_files(
    name = "generate",
    files = {
        "files.pb.go": ":files_pb_go_only",
        "files_vtproto.pb.go": ":files_vt_pb_go_only",
    },
)
