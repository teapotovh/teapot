    name = "netbase_static_debian13",
    digest = "sha256:7dbbc26a6b1bddebf087ba3515ce4701ed97a50bcd6a87971aca45eca459d06f",
    registry = "ghcr.io",
    repository = "teapotovh/netbase",
    tag = "latest",
    layer_handling = "lazy",
)

