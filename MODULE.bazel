    name = "distroless_cc_debian13",
    digest = "sha256:ed7c407fd64eb0af9dddb9456b94cee188a40a7f53cf38c9836e1e9ae14fca02",
    registry = "gcr.io",
    repository = "distroless/cc-debian13",
    tag = "latest",
    layer_handling = "lazy",
)

